# Postgres connection string (Neon, Vercel Postgres, Supabase, or local)
DATABASE_URL="postgresql://user:password@localhost:5432/vista_bonus?schema=public"

# Signing secret for session cookies. Generate with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-32-byte-random-string"

# Required in a deployed instance. Gates the one-time /setup page where the owner
# account is created. At least 8 characters. Generate with: openssl rand -hex 16
SETUP_TOKEN=""

# Local development only — used by `npm run db:seed`, never by a deployment.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-before-first-run"

# Timezone the shop operates in — decides which calendar day an entry lands on.
SHOP_TIMEZONE="America/Los_Angeles"
